# --- Agent session auth (one of the two) ---
# Subscription token: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Or an API key from console.anthropic.com
ANTHROPIC_API_KEY=

# --- Runner ---
# docker (default on the Mac) | process (dev, no isolation)
LEGION_RUNNER=docker
# Session image (built with `pnpm build:image`)
LEGION_SESSION_IMAGE=legion-session:latest

# --- Server ---
PORT=8790
# Who may act on the API: an operator session (token printed once at first boot) or
# `Authorization: Bearer <token>`. Who can reach the port is the job of the firewall and the
# tailnet ACLs, not of this process.
# URL containers use to call the control plane back.
# Docker Desktop on macOS: host.docker.internal works by default.
LEGION_CALLBACK_URL=http://host.docker.internal:8790

# --- Forges ---
# Hosts a forge token (GITHUB_TOKEN, GITLAB_TOKEN) may be presented to. github.com and gitlab.com
# always are; declare self-hosted instances here, comma-separated, with the port if non-standard
# (e.g. git.example.com,gitlab.local:8443). A repository URL on another host is refused at creation,
# and a stored repository on such a host gets no token; the review screen names the error.
LEGION_FORGE_HOSTS=

# --- OAuth connections (project page › Integrations) ---
# Connect GitHub, GitLab or Linear without pasting a token. Each provider needs a registered app, whose
# `client_id` is public by design (it travels in the consent URL): these are not secrets. A missing
# variable breaks nothing at boot; the "Connect" button refuses and says what is missing.
#
# GitHub: registered app with "Enable Device Flow" ticked (otherwise GitHub answers
# `device_flow_disabled`). A default value is committed in code; set this to run your own instance
# with your own app.
LEGION_GITHUB_CLIENT_ID=
# GitLab: one app per instance (the gitlab.com client id is worthless on a self-hosted GitLab). Set
# both variables or neither.
#
# These are instance defaults, not a connection's configuration (15/09): the host belongs to the
# connection, asked for on the Integrations tile, and what is typed there wins. These only prefill the
# field. Empty, the tile suggests https://gitlab.com as a visible suggestion, never a silent guess: a
# silently assumed host is what refused a valid framagit token.
LEGION_GITLAB_CLIENT_ID=
LEGION_GITLAB_HOST=
# Linear: the only one of the three that returns through the browser (authorization code + PKCE; the
# other two are device grants). Empty = the refusal says no app is declared and gives the redirect URL
# to copy into Linear's registration form.
LEGION_LINEAR_CLIENT_ID=
# The address the operator's browser uses to reach Legion, not the one third-party servers use (that is
# the inbound webhooks public URL, limited to the Funnel). Legion need not be publicly reachable, only
# reachable by the browser. Examples: http://localhost:8790 on a workstation, https://<machine>.ts.net
# behind a Tailscale name, a domain behind a reverse proxy.
#
# It must be registered identically at the provider: Linear compares both strings at token exchange,
# and a one-character difference gives a refusal that says nothing. Without it no Linear flow opens;
# GitHub and GitLab do not need it (a device grant has no redirect URL, so it works even on an instance
# reached by IP, without DNS or TLS).
LEGION_PUBLIC_URL=

# --- Secrets (AES-256-GCM encryption in the DB) ---
# Generate: openssl rand -hex 32
LEGION_MASTER_KEY=

# --- Discord (mobile inbox: questions + answer buttons) ---
# 1. https://discord.com/developers/applications → New Application → Bot → copy the token
# 2. Invite the bot to your private server (OAuth2 → URL generator → scopes: bot;
#    permissions: Send Messages, Read Message History)
# 3. Enable Discord developer mode, right-click the channel → Copy ID
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
