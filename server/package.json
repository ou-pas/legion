{
  "name": "@legion/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx src/projects/seed/demo.ts",
    "test": "node --import tsx --test --test-reporter=dot --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/migrations/**' --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=75 \"src/**/*.test.ts\"",
    "test:verbose": "node --import tsx --test --test-reporter=spec \"src/**/*.test.ts\"",
    "seed:self": "tsx src/projects/seed/self.ts",
    "smoke": "tsx src/http/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.234",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^12.0.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "nanoid": "^5.1.0",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
